{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App profile",
  "description": "The screens, navigation edges, forms and features the executor may use.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_version", "screens", "edges", "forms", "features", "user_only_actions"],
  "properties": {
    "profile_version": { "type": "integer", "minimum": 0 },
    "screens": {
      "description": "Screen IDs.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "edges": {
      "description": "Navigation steps the executor may take.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "action"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "requires": {
            "description": "Selections needed before the move: the key replaces the * in the action.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "type", "ask"],
              "properties": {
                "ref": { "type": "string", "minLength": 1 },
                "type": { "enum": ["ref", "choice"] },
                "description": { "type": "string", "minLength": 1 },
                "ask": { "description": "The question in Persian.", "type": "string", "minLength": 1 },
                "lookup": { "description": "Where the records come from. Needed when type is ref.", "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fields"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "type"],
              "properties": {
                "ref": { "type": "string", "minLength": 1 },
                "type": { "enum": ["text", "money", "ref", "choice"] },
                "secret": { "description": "True when only the user may enter it. Never filled.", "type": "boolean" },
                "requires": { "description": "True when the screen will not continue without it.", "type": "boolean" },
                "ask": { "description": "The question in Persian.", "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "lookup": { "description": "Where a ref field's records come from.", "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent", "description", "required_slots", "lookups", "destination", "form"],
        "properties": {
          "intent": { "type": "string", "minLength": 1 },
          "description": { "description": "One line.", "type": "string", "minLength": 1 },
          "required_slots": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "lookups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "destination": { "description": "A screen ID.", "type": "string", "minLength": 1 },
          "form": { "description": "A form ID, or null.", "type": ["string", "null"] }
        }
      }
    },
    "user_only_actions": {
      "description": "Actions only the user may perform, such as the final confirmation. No edge may use them.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
