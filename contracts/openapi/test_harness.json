{
  "openapi": "3.1.0",
  "info": {
    "title": "Test harness API",
    "version": "1",
    "description": "Development-only controls. Never an assistant tool."
  },
  "paths": {
    "/test-harness/v1/reset": {
      "post": {
        "operationId": "resetFixtures",
        "summary": "Reset the mock fixtures",
        "responses": { "200": { "description": "Fixtures reset" } }
      }
    },
    "/test-harness/v1/scenario": {
      "post": {
        "operationId": "chooseScenario",
        "summary": "Choose a test scenario",
        "responses": { "200": { "description": "Scenario chosen" } }
      }
    }
  }
}
