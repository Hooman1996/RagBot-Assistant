{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "description": "The backend's reply to the app: a message, a clarification, a status or one command.",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": { "enum": ["message", "clarification", "status", "command"] }
  },
  "allOf": [
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "message" } } },
      "then": {
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "kind": true,
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "clarification" } } },
      "then": {
        "additionalProperties": false,
        "required": ["question_id", "text", "options"],
        "properties": {
          "kind": true,
          "question_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "label"],
              "properties": {
                "ref": { "type": "string", "minLength": 1 },
                "label": { "description": "Masked display label.", "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "status" } } },
      "then": {
        "additionalProperties": false,
        "required": ["task_state"],
        "properties": {
          "kind": true,
          "task_state": {
            "enum": [
              "created",
              "clarifying",
              "resolving",
              "preparing",
              "verifying_review",
              "ready_for_user",
              "paused",
              "reconciling",
              "cancelling",
              "failed",
              "cancelled",
              "completed"
            ]
          },
          "review_facts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "value"],
              "properties": {
                "ref": { "type": "string", "minLength": 1 },
                "value": { "description": "Masked display value.", "type": "string" }
              }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "command" } } },
      "then": {
        "additionalProperties": false,
        "required": ["command"],
        "properties": {
          "kind": true,
          "command": { "$ref": "command.schema.json" }
        }
      }
    }
  ]
}
