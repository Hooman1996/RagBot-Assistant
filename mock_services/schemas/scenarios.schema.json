{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mock data: scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "forced",
    "messages"
  ],
  "properties": {
    "forced": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "outcome"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
