{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mock data: contacts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "people",
    "destinations"
  ],
  "properties": {
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "card",
          "account",
          "iban",
          "wallet"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "card": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "iban": {
            "type": "string"
          },
          "wallet": {
            "type": "string"
          }
        }
      }
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "name",
          "destination",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
