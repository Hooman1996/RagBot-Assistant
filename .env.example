# Project settings (plan §15). Copy to .env, which git ignores, and replace each change-me.
# Hosts must be development hosts (localhost or 127.0.0.1); names must be the project's own,
# never RagBot's. `python tools/project_checks.py isolation` checks this file.

# Shared dev PostgreSQL (Docker). The project uses only its own database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragbot_assistant_dev

# Assistant service: conversations and tasks, in the assistant schema only.
ASSISTANT_DB_SCHEMA=assistant
ASSISTANT_DB_USER=assistant_app
ASSISTANT_DB_PASSWORD=change-me

# Mock banking service: synthetic banking data, in the mock_bank schema only.
MOCK_BANK_DB_SCHEMA=mock_bank
MOCK_BANK_DB_USER=mock_bank_app
MOCK_BANK_DB_PASSWORD=change-me

# Mock banking HTTP API used by the application adapter. The port is a placeholder until P4.
MOCK_BANK_URL=http://localhost:8010

# Shared dev Qdrant (Docker). The project uses only its own collection.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ragbot_assistant_knowledge

# MinIO stays off. The task that enables it adds its endpoint and keys.
MINIO_ENABLED=false
MINIO_BUCKET=ragbot-assistant-dev
